FROM python:3.11-slim

WORKDIR /app

# Install system dependencies (ffmpeg for video, OpenGL for CV)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    git \
    pkg-config \
    libavformat-dev \
    libavcodec-dev \
    libavdevice-dev \
    libavutil-dev \
    libswscale-dev \
    libswresample-dev \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

# Install full Python dependencies (including ML/CV)
COPY backend/requirements.txt .
# Stage 1: setuptools must be available for openai-whisper's setup.py
RUN pip install --no-cache-dir --upgrade pip setuptools wheel
# Stage 2: Install torch first (heavy, whisper dependency)
RUN pip install --no-cache-dir torch==2.2.0 torchvision==0.17.0 numpy==1.26.4
# Stage 3: Install openai-whisper from GitHub (PyPI version uses deprecated pkg_resources)
RUN pip install --no-cache-dir git+https://github.com/openai/whisper.git
# Stage 4: Install remaining requirements
RUN pip install --no-cache-dir -r requirements.txt

# Install additional AWS dependencies
RUN pip install --no-cache-dir boto3==1.34.44 mangum==0.17.0

# Copy application code
COPY backend/ .

# Create necessary directories and non-root user
RUN mkdir -p ml_models data \
    && groupadd -r appuser && useradd -r -g appuser -d /app appuser \
    && chown -R appuser:appuser /app

USER appuser

# Default entrypoint for ECS RunTask (overridden via container command)
ENTRYPOINT ["python", "-m", "app.tasks.runner"]
