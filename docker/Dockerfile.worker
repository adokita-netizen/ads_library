FROM python:3.11-slim

WORKDIR /app

# Install system dependencies (ffmpeg for video, OpenGL for CV)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

# Install full Python dependencies (including ML/CV)
COPY backend/requirements.txt .
# 1. Install pip/setuptools/wheel first
# 2. Install torch (whisper dependency) before whisper itself
# 3. Install whisper with --no-build-isolation (its setup.py uses pkg_resources)
# 4. Install remaining requirements
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir torch==2.2.0 torchvision==0.17.0 numpy==1.26.4 && \
    pip install --no-cache-dir --no-build-isolation openai-whisper==20231117 && \
    pip install --no-cache-dir -r requirements.txt

# Install additional AWS dependencies
RUN pip install --no-cache-dir boto3==1.34.44 mangum==0.17.0

# Copy application code
COPY backend/ .

# Create necessary directories and non-root user
RUN mkdir -p ml_models data \
    && groupadd -r appuser && useradd -r -g appuser -d /app appuser \
    && chown -R appuser:appuser /app

USER appuser

# Default entrypoint for ECS RunTask (overridden via container command)
ENTRYPOINT ["python", "-m", "app.tasks.runner"]
