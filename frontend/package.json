{
  "name": "vaap-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:table": "playwright test --grep @table",
    "test:e2e:visual": "playwright test --grep @visual",
    "test:e2e:visual:update": "playwright test --grep @visual --update-snapshots",
    "test:e2e:slow": "playwright test --grep @slow",
    "test:e2e:state": "playwright test --grep @state",
    "test:e2e:critical": "playwright test --grep \"@table|@state|@slow\"",
    "test:e2e:a11y:contrast": "playwright test --grep @a11y-contrast",
    "test:contracts": "tsc -p tsconfig.contracts.json --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.18.1",
    "axios": "1.13.5",
    "clsx": "2.1.0",
    "date-fns": "3.3.1",
    "next": "14.2.35",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hot-toast": "2.4.1",
    "tailwind-merge": "2.2.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@playwright/test": "^1.49.0",
    "@storybook/addon-a11y": "^10.2.14",
    "@storybook/addon-docs": "^10.2.14",
    "@storybook/addon-onboarding": "^10.2.14",
    "@storybook/addon-vitest": "^10.2.14",
    "@storybook/nextjs-vite": "^10.2.14",
    "@types/node": "^20.19.0",
    "@types/react": "18.2.55",
    "@types/react-dom": "18.2.19",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "10.4.17",
    "axe-playwright": "^2.2.2",
    "playwright": "^1.58.2",
    "postcss": "8.4.34",
    "storybook": "^10.2.14",
    "tailwindcss": "3.4.1",
    "typescript": "5.3.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
